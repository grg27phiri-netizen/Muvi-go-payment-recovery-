:root{font-family:Inter,system-ui,sans-serif;background:#080b12;color:#f5f7fb}*{box-sizing:border-box}body{margin:0}header{height:70px;display:flex;align-items:center;justify-content:space-between;padding:0 5%;background:#0d111a;border-bottom:1px solid #222936;position:sticky;top:0;z-index:3}.brand{font-weight:900;font-size:25px;letter-spacing:2px}.brand span{font-weight:500}nav{display:flex;gap:18px;flex-wrap:wrap}nav a{color:#cbd2df;text-decoration:none}.hero{min-height:530px;padding:90px 7%;display:flex;align-items:center;background:radial-gradient(circle at 70% 40%,#26324a,transparent 42%),linear-gradient(135deg,#101828,#070a10)}.hero>div{max-width:700px}.eyebrow{letter-spacing:3px;font-size:12px;color:#aeb8c9}h1{font-size:clamp(40px,7vw,76px);line-height:.98;margin:15px 0}h2{font-size:30px}.hero p:not(.eyebrow){font-size:18px;color:#b8c1d0;max-width:650px;line-height:1.6}.btn{display:inline-block;margin:12px 10px 0 0;padding:12px 20px;border-radius:10px;background:#fff;color:#090c12;text-decoration:none;border:0;font-weight:700;cursor:pointer}.btn.ghost{background:transparent;color:#fff;border:1px solid #566174}.section{padding:55px 7%}.sectionhead{display:flex;justify-content:space-between;gap:20px;align-items:center}input,select{padding:13px 15px;border-radius:9px;border:1px solid #343d4d;background:#111722;color:#fff;margin:5px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px}.card{background:#111722;border:1px solid #222c3b;border-radius:15px;overflow:hidden}.poster{height:170px;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#27334a,#151b27);font-weight:900;letter-spacing:2px}.cardbody{padding:16px}.card h3{margin:0 0 8px}.card p,.muted,small{color:#9da8b9;line-height:1.5}footer{text-align:center;padding:30px;color:#758095;border-top:1px solid #202735;font-size:13px}form{display:flex;flex-wrap:wrap;gap:5px;margin:20px 0 40px}